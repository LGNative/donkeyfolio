+    /// If `symbol` is an ISIN, resolve it to a real Yahoo ticker via search
+    /// (e.g. "US75734B1008" → "RDDT") so quotes can be fetched. Non-ISIN
+    /// symbols are returned unchanged. The mapping is cached per ISIN, and a
+    /// failed lookup is cached as such to avoid repeated searches.
+    async fn resolve_isin_to_ticker(&self, symbol: &str) -> String {
+        if !looks_like_isin(symbol) {
+            return symbol.to_string();
+        }
+        if let Ok(cache) = ISIN_TICKER_CACHE.read() {
+            if let Some(cached) = cache.get(symbol) {
+                return cached.clone().unwrap_or_else(|| symbol.to_string());
+            }
+        }
+        let resolved = match self.search_single(symbol).await {
+            Ok(results) => results
+                .into_iter()
+                .filter(|r| {
+                    !r.symbol.trim().is_empty()
+                        && matches!(
+                            r.asset_type.to_ascii_uppercase().as_str(),
+                            "EQUITY" | "ETF" | "MUTUALFUND"
+                        )
+                })
+                .max_by(|a, b| {
+                    a.score
+                        .unwrap_or(0.0)
+                        .partial_cmp(&b.score.unwrap_or(0.0))
+                        .unwrap_or(std::cmp::Ordering::Equal)
+                })
+                .map(|r| r.symbol),
+            Err(e) => {
+                debug!("ISIN→ticker search failed for {}: {}", symbol, e);
+                None
+            }
+        };
+        match &resolved {
+            Some(t) => debug!("Resolved ISIN {} → ticker {}", symbol, t),
+            None => debug!("Could not resolve ISIN {} to a Yahoo ticker", symbol),
+        }
+        if let Ok(mut cache) = ISIN_TICKER_CACHE.write() {
+            cache.insert(symbol.to_string(), resolved.clone());
+        }
+        resolved.unwrap_or_else(|| symbol.to_string())
+    }
