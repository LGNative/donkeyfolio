soft (widest-sleeve) tolerance band; match the solid band's var(--brand-300).

Co-Authored-By: Claude Opus 4.8 <noreply@anthropic.com>
---
 .../src/pages/allocation-targets/components/rebalance-tab.tsx   | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/apps/frontend/src/pages/allocation-targets/components/rebalance-tab.tsx b/apps/frontend/src/pages/allocation-targets/components/rebalance-tab.tsx
index ce3cade9..30fb2948 100644
--- a/apps/frontend/src/pages/allocation-targets/components/rebalance-tab.tsx
+++ b/apps/frontend/src/pages/allocation-targets/components/rebalance-tab.tsx
@@ -603,7 +603,7 @@ function DriftBar({
                 style={{
                   left: `${toleranceMinPos}%`,
                   width: `${toleranceMaxPos - toleranceMinPos}%`,
-                  background: "#9db8a8",
+                  background: "var(--brand-300)",
                 }}
               />
             )}
