+++++  // Group errors by message for legibility (1500 "duplicate" → 1 row)
+++++  const errorGroups = React.useMemo(() => {
+++++    const groups = new Map<string, number>();
+++++    for (const e of errors) {
+++++      const key = e.message;
+++++      groups.set(key, (groups.get(key) ?? 0) + 1);
