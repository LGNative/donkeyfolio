+++++              >
+++++                {droppedCount.toLocaleString("en-US")}
+++++              </p>
+++++              <p className="text-muted-foreground text-xs">{errors.length} backend errors</p>
+++++            </div>
+++++          </div>
+++++
+++++          {hasErrors && (
