From 41f251326266d17331aef881608437fd6b147baf Mon Sep 17 00:00:00 2001
From: LGNative <luis@nativestride.io>
Date: Mon, 8 Jun 2026 21:00:54 +0100
Subject: [PATCH 04/30] Polish: zero drivers, large-% decimals, sort holdings
 by return %
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

- Net Worth "Monthly pace": hide drivers that are effectively €0 (e.g.
  "Equity built" for portfolios with no debt) so the panel has no dead rows
- Percentages: drop the decimals once a value reaches 100% — they are noise on a
  large number (an all-time return shows +27,994% instead of +27,994.67%);
  values under 100% keep 2 decimals (e.g. +20.62%). Applied in formatPercent and
  the animated GainPercent
- Holdings table: the gain/loss column now sorts by return % (performance)
  instead of absolute € (which just mirrored position size); % is also
  currency-agnostic

Co-Authored-By: Claude Opus 4.8 <noreply@anthropic.com>
---
 .../src/pages/holdings/components/holdings-table.tsx   | 10 ++++++----
 .../src/pages/net-worth/components/velocity-card.tsx   |  3 +++
 packages/ui/src/components/financial/gain-percent.tsx  |  5 +++--
 packages/ui/src/lib/utils.ts                           |  8 ++++++--
 4 files changed, 18 insertions(+), 8 deletions(-)

diff --git a/apps/frontend/src/pages/holdings/components/holdings-table.tsx b/apps/frontend/src/pages/holdings/components/holdings-table.tsx
index 840b7ef2..bbeeba93 100644
--- a/apps/frontend/src/pages/holdings/components/holdings-table.tsx
+++ b/apps/frontend/src/pages/holdings/components/holdings-table.tsx
@@ -466,11 +466,13 @@ const getColumns = (
       const holdingA = rowA.original;
       const holdingB = rowB.original;
 
-      // Always sort by base currency value for consistency
-      const valueA = holdingA.totalGain?.base ?? 0;
-      const valueB = holdingB.totalGain?.base ?? 0;
+      // Sort by return % (performance — what this column's percentage line shows)
+      // rather than absolute € (which just mirrors position size). % is also
+      // currency-agnostic.
+      const pctA = holdingA.totalGainPct ?? 0;
+      const pctB = holdingB.totalGainPct ?? 0;
 
-      return valueA - valueB;
+      return pctA - pctB;
     },
   },
   {
diff --git a/apps/frontend/src/pages/net-worth/components/velocity-card.tsx b/apps/frontend/src/pages/net-worth/components/velocity-card.tsx
index 02c39286..ea31c6f8 100644
--- a/apps/frontend/src/pages/net-worth/components/velocity-card.tsx
+++ b/apps/frontend/src/pages/net-worth/components/velocity-card.tsx
@@ -15,6 +15,9 @@ function DriverRow({
   total: number;
   currency: string;
 }) {
+  // Hide drivers that are effectively zero (e.g. "Equity built" for portfolios
+  // with no debt) so the panel doesn't carry dead rows.
+  if (Math.abs(value) < 0.005) return null;
   const perMonth = months > 0 ? value / months : value;
   const share = total > 0 ? (Math.abs(value) / total) * 100 : 0;
   const sign = Math.abs(value) < 0.005 ? "" : value > 0 ? "+" : "-";
diff --git a/packages/ui/src/components/financial/gain-percent.tsx b/packages/ui/src/components/financial/gain-percent.tsx
index 91fdee5c..ac7e0477 100644
--- a/packages/ui/src/components/financial/gain-percent.tsx
+++ b/packages/ui/src/components/financial/gain-percent.tsx
@@ -19,6 +19,7 @@ function AnimatedNumber({ value }: { value: number }) {
   const [NumberFlow, setNumberFlow] = React.useState<React.ComponentType<any> | null>(null);
 
   const absValue = Math.abs(value * 100);
+  const digits = absValue >= 100 ? 0 : 2;
   React.useEffect(() => {
     import("@number-flow/react").then((module) => {
       setNumberFlow(module.default);
@@ -41,8 +42,8 @@ function AnimatedNumber({ value }: { value: number }) {
       value={absValue}
       animated={true}
       format={{
-        minimumFractionDigits: 2,
-        maximumFractionDigits: 2,
+        minimumFractionDigits: digits,
+        maximumFractionDigits: digits,
       }}
     />
   );
diff --git a/packages/ui/src/lib/utils.ts b/packages/ui/src/lib/utils.ts
index 6a40d37b..a07423a6 100644
--- a/packages/ui/src/lib/utils.ts
+++ b/packages/ui/src/lib/utils.ts
@@ -160,11 +160,15 @@ export function formatCompactAmount(
 export function formatPercent(value: number | null | undefined) {
   if (value == null) return "-";
   try {
+    // Drop decimals once the percentage reaches 100% — they are just noise on a
+    // large number (e.g. an all-time return of +27,994%). value is a fraction,
+    // so |value| >= 1 means the percentage is >= 100%.
+    const digits = Math.abs(value) >= 1 ? 0 : 2;
     // Use Intl.NumberFormat for correct percentage formatting (handles x100 and % sign)
     return new Intl.NumberFormat("en-US", {
       style: "percent",
-      minimumFractionDigits: 2,
-      maximumFractionDigits: 2,
+      minimumFractionDigits: digits,
+      maximumFractionDigits: digits,
     }).format(value);
   } catch (error) {
     console.error(`Error formatting percent ${value}: ${error}`);
-- 
