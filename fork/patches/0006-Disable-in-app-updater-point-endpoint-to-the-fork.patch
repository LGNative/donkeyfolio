From 9b035b207fb71d0c62a33e2e3d9615bd36ba3546 Mon Sep 17 00:00:00 2001
From: LGNative <luis@nativestride.io>
Date: Tue, 9 Jun 2026 09:53:04 +0100
Subject: [PATCH 06/24] Disable in-app updater: point endpoint to the fork

The upstream endpoint (wealthfolio.app/releases) + retained pubkey let the
in-app 'Check for Update' install official Wealthfolio over the fork, switching
the bundle identifier and DB. Point the updater at the fork's (empty) releases
so it never fetches an upstream artifact.

Co-Authored-By: Claude Opus 4.8 <noreply@anthropic.com>
---
 apps/tauri/tauri.conf.json | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/apps/tauri/tauri.conf.json b/apps/tauri/tauri.conf.json
index e2799820..2070f87a 100644
--- a/apps/tauri/tauri.conf.json
+++ b/apps/tauri/tauri.conf.json
@@ -45,7 +45,7 @@
   "plugins": {
     "updater": {
       "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDY0RjI4MkRFOUYwRDM3N0QKUldSOU53MmYzb0x5WlBySmErU21wcjVHZFNtMW9zdGcyZTBBRWpVcHRDMkoyKzF1bkQ1VmdKbkYK",
-      "endpoints": ["https://wealthfolio.app/releases/{{target}}/{{arch}}/{{current_version}}"],
+      "endpoints": ["https://github.com/LGNative/donkeyfolio/releases/latest/download/latest.json"],
       "windows": {
         "installMode": "passive"
       }
-- 
