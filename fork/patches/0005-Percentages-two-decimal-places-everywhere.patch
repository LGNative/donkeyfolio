From a0270cb108b76fed7cafd45afc7d81592debc15b Mon Sep 17 00:00:00 2001
From: LGNative <luis@nativestride.io>
Date: Tue, 9 Jun 2026 09:37:08 +0100
Subject: [PATCH 05/28] Percentages: two decimal places everywhere

Co-Authored-By: Claude Opus 4.8 <noreply@anthropic.com>
---
 apps/frontend/src/pages/net-worth/components/utils.ts | 4 ++--
 packages/ui/src/components/financial/gain-percent.tsx | 5 ++---
 packages/ui/src/lib/utils.ts                          | 8 ++------
 3 files changed, 6 insertions(+), 11 deletions(-)

diff --git a/apps/frontend/src/pages/net-worth/components/utils.ts b/apps/frontend/src/pages/net-worth/components/utils.ts
index 6e1ef6af..9f214698 100644
--- a/apps/frontend/src/pages/net-worth/components/utils.ts
+++ b/apps/frontend/src/pages/net-worth/components/utils.ts
@@ -150,10 +150,10 @@ export function deriveChange(series: number[], isLiability: boolean): Change {
   return { amount, percent: base > 0 ? amount / base : 0 };
 }
 
-/** Percent is a ratio (0.145 = 14.5%); drop decimals for very large swings. */
+/** Percent is a ratio (0.145 = 14.5%); shown with two decimals. */
 export function formatChangePercent(percent: number): string {
   const abs = Math.abs(percent);
-  return formatPercent(abs, { digits: abs >= 10 ? 0 : 1, signDisplay: "never" });
+  return formatPercent(abs, { digits: 2, signDisplay: "never" });
 }
 
 const MS_PER_DAY = 86_400_000;
diff --git a/packages/ui/src/components/financial/gain-percent.tsx b/packages/ui/src/components/financial/gain-percent.tsx
index ac7e0477..91fdee5c 100644
--- a/packages/ui/src/components/financial/gain-percent.tsx
+++ b/packages/ui/src/components/financial/gain-percent.tsx
@@ -19,7 +19,6 @@ function AnimatedNumber({ value }: { value: number }) {
   const [NumberFlow, setNumberFlow] = React.useState<React.ComponentType<any> | null>(null);
 
   const absValue = Math.abs(value * 100);
-  const digits = absValue >= 100 ? 0 : 2;
   React.useEffect(() => {
     import("@number-flow/react").then((module) => {
       setNumberFlow(module.default);
@@ -42,8 +41,8 @@ function AnimatedNumber({ value }: { value: number }) {
       value={absValue}
       animated={true}
       format={{
-        minimumFractionDigits: digits,
-        maximumFractionDigits: digits,
+        minimumFractionDigits: 2,
+        maximumFractionDigits: 2,
       }}
     />
   );
diff --git a/packages/ui/src/lib/utils.ts b/packages/ui/src/lib/utils.ts
index a07423a6..6a40d37b 100644
--- a/packages/ui/src/lib/utils.ts
+++ b/packages/ui/src/lib/utils.ts
@@ -160,15 +160,11 @@ export function formatCompactAmount(
 export function formatPercent(value: number | null | undefined) {
   if (value == null) return "-";
   try {
-    // Drop decimals once the percentage reaches 100% — they are just noise on a
-    // large number (e.g. an all-time return of +27,994%). value is a fraction,
-    // so |value| >= 1 means the percentage is >= 100%.
-    const digits = Math.abs(value) >= 1 ? 0 : 2;
     // Use Intl.NumberFormat for correct percentage formatting (handles x100 and % sign)
     return new Intl.NumberFormat("en-US", {
       style: "percent",
-      minimumFractionDigits: digits,
-      maximumFractionDigits: digits,
+      minimumFractionDigits: 2,
+      maximumFractionDigits: 2,
     }).format(value);
   } catch (error) {
     console.error(`Error formatting percent ${value}: ${error}`);
-- 
